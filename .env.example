# Create these values in a GitHub OAuth App. Never commit the real values.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Use a long random value to sign the Keystatic session cookie.
KEYSTATIC_SECRET=

# Slug of the Keystatic GitHub App after it is created and installed.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Public base URL used for canonical URLs, sitemap, robots, and social metadata.
NEXT_PUBLIC_SITE_URL=https://staging.gcua.us

# Frappe CRM integration (server-side only — never expose these to the browser).
# Create a dedicated CRM user with the Sales User role and generate an API key/secret.
CRM_BASE_URL=http://160.236.68.94
CRM_API_KEY=
CRM_API_SECRET=
# Optional: CRM user email that should own submitted leads (e.g. an admissions salesperson).
CRM_LEAD_OWNER=