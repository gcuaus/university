# Create these values in a GitHub OAuth App. Never commit the real values.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Use a long random value to sign the Keystatic session cookie.
KEYSTATIC_SECRET=

# Slug of the Keystatic GitHub App after it is created and installed.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Public base URL used for canonical URLs, sitemap, robots, and social metadata.
NEXT_PUBLIC_SITE_URL=https://staging.gcua.us

# Frappe CRM hosted web form URL (Settings -> Forms -> Share -> Link),
# e.g. https://crm.gcua.us/crm-form/apply
# When set, the homepage Apply/Evaluation section shows the CRM form.
# Mode: "link" opens the hosted form in a new tab (safe with HTTP URLs);
#       "embed" renders it in an iframe (requires HTTPS when the site is HTTPS).
NEXT_PUBLIC_CRM_FORM_URL=
NEXT_PUBLIC_CRM_FORM_MODE=link